{
  "name": "mvp_active_quest_progress_events",
  "goal": "A blocker mission should move through visible phases and emit in-progress quest events before resolving.",
  "seed": 7,
  "max_ticks": 0,
  "commands": [
    {"cmd": "place_building", "type": "tavern", "x": 0, "z": 0},
    {"cmd": "set_building_output_mode", "type": "tavern"},
    {"cmd": "step_ticks", "n": 600},
    {"cmd": "accept_quest", "index": 0, "hero_ids": [1, 3]},
    {"cmd": "step_ticks", "n": 1800}
  ],
  "assertions": [
    {"assert": "event_type_seen", "value": "quest_phase_changed"},
    {"assert": "event_type_seen", "value": "quest_progress_event"},
    {"assert": "completed_quest_count_gte", "value": 1}
  ]
}
